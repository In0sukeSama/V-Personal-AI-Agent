# Copy this file to ".env" (exactly that name, nothing before or after) and fill in your real keys.
# Never commit the real ".env" file to GitHub.

# Free, no credit card needed - get yours at console.groq.com
GROQ_API_KEY=gsk_your-key-here

# TTS_PROVIDER controls voice output. "pyttsx3" (default) is free and local.
# Set to "elevenlabs" once you have a plan that allows API access to your voice.
TTS_PROVIDER=pyttsx3
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=weA4Q36twV5kwSaTEL0Q

# Optional: OpenWeather API key for the weather tool (free tier at openweathermap.org)
OPENWEATHER_API_KEY=your-openweather-key-here
OPENWEATHER_CITY=London
